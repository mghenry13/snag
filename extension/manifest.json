{
  "manifest_version": 3,
  "name": "Snag",
  "version": "1.0",
  "description": "Save images, videos, and pages into your Snag library.",
  "permissions": [
    "contextMenus",
    "activeTab",
    "scripting",
    "tabs",
    "notifications",
    "alarms", "storage", "offscreen"
  ],
  "host_permissions": [
    "http://127.0.0.1:41777/*",
    "<all_urls>"
  ],
  "commands": {
    "save-page": {
      "suggested_key": { "default": "Alt+Shift+1", "mac": "Alt+Shift+1" },
      "description": "Save URL (with a screenshot of the page)"
    },
    "batch-save": {
      "suggested_key": { "default": "Alt+Shift+2", "mac": "Alt+Shift+2" },
      "description": "Batch save images on the page"
    },
    "capture-area": {
      "suggested_key": { "default": "Alt+Shift+3", "mac": "Alt+Shift+3" },
      "description": "Capture an area"
    },
    "capture-visible": {
      "suggested_key": { "default": "Alt+Shift+4", "mac": "Alt+Shift+4" },
      "description": "Capture the visible page"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Snag"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/ads/library*"
      ],
      "js": [
        "fb-ads-intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.facebook.com/ads/library*"
      ],
      "js": [
        "fb-ads.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "ig-intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://www.instagram.com/*"
      ],
      "js": [
        "ig.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "x-intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://x.com/*",
        "https://twitter.com/*",
        "https://mobile.twitter.com/*"
      ],
      "js": [
        "x.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "exclude_matches": [
        "https://www.facebook.com/ads/library*"
      ],
      "js": [
        "fb-intercept.js"
      ],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "exclude_matches": [
        "https://www.facebook.com/ads/library*"
      ],
      "js": [
        "fb.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "linkedin-main.js"
      ],
      "run_at": "document_idle",
      "world": "MAIN"
    },
    {
      "matches": [
        "https://www.linkedin.com/*"
      ],
      "js": [
        "linkedin.js"
      ],
      "run_at": "document_idle"
    }
  ]
}